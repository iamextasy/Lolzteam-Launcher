{
  "name": "@lolzteam/desktop",
  "version": "1.1.1",
  "private": true,
  "description": "Lolzteam Launcher — desktop app",
  "homepage": "https://github.com/iamextasy/Lolzteam-Launcher",
  "author": {
    "name": "iamextasy",
    "email": "iamextasy@users.noreply.github.com"
  },
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "pack": "electron-vite build && electron-builder --dir",
    "dist": "electron-vite build && electron-builder",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@fuman/net": "0.0.19",
    "@fuman/node": "0.0.19",
    "@mtcute/convert": "^0.29.7",
    "@mtcute/core": "^0.29.7",
    "@mtcute/node": "^0.29.7",
    "better-sqlite3": "^12.10.0",
    "country-flag-icons": "^1.6.17",
    "dompurify": "^3.4.9",
    "electron-log": "^5.2.4",
    "electron-updater": "^6.8.3",
    "ky": "^1.7.4",
    "sql.js": "^1.14.1",
    "steam-session": "^1.9.2"
  },
  "devDependencies": {
    "@lolzteam/adapter-contract": "workspace:*",
    "@lolzteam/market-sdk": "workspace:*",
    "@lolzteam/shared-ipc": "workspace:*",
    "@lolzteam/shared-types": "workspace:*",
    "@tanstack/react-query": "^5.62.7",
    "@tanstack/react-virtual": "^3.14.9",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@types/sql.js": "^1.4.11",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "electron-vite": "^5.0.0",
    "i18next": "^26.3.0",
    "jsdom": "^26.0.0",
    "jsqr": "^1.4.0",
    "lucide-react": "^0.469.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-i18next": "^17.0.8",
    "sass": "^1.83.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vitest": "^4.1.7",
    "zustand": "^5.0.2"
  },
  "build": {
    "appId": "com.lolzteam.launcher",
    "productName": "Lolzteam Launcher",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "afterPack": "build/after-pack.cjs",
    "files": [
      "out/**/*",
      "package.json",
      "!node_modules/better-sqlite3/{deps,build/Release/obj,src}/**",
      "!node_modules/**/*.{c,cc,cpp,h,hpp,ts,map,md,markdown}",
      "!node_modules/**/{test,tests,__tests__,example,examples,docs,.github}/**"
    ],
    "win": {
      "target": ["nsis"],
      "icon": "build/icon.ico"
    },
    "mac": {
      "target": ["dmg"],
      "icon": "build/icon.icns",
      "category": "public.app-category.utilities",
      "identity": null
    },
    "linux": {
      "target": ["AppImage", "deb"],
      "icon": "build/icon.png",
      "category": "Network;Utility",
      "synopsis": "Вход в аккаунты, купленные на lzt.market",
      "description": "Lolzteam Launcher — вход в купленные на lzt.market аккаунты Steam, Telegram, Discord и других сервисов в один клик.",
      "maintainer": "iamextasy <iamextasy@users.noreply.github.com>",
      "desktop": {
        "Keywords": "lolzteam;lzt;market;steam;telegram;"
      },
      "executableName": "lolzteam-launcher"
    },
    "deb": {
      "packageName": "lolzteam-launcher",
      "artifactName": "lolzteam-launcher_${version}_${arch}.${ext}",
      "afterInstall": "build/deb-after-install.tpl"
    },
    "appImage": {
      "artifactName": "Lolzteam-Launcher-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerSidebar": "build/installerSidebar.bmp",
      "uninstallerSidebar": "build/uninstallerSidebar.bmp"
    },
    "protocols": [
      {
        "name": "Lolzteam Launcher",
        "schemes": ["lolzteamlauncher"]
      }
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "iamextasy",
        "repo": "Lolzteam-Launcher"
      }
    ]
  }
}
