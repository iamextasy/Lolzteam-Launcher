{
  "name": "lolzteam-launcher",
  "private": true,
  "version": "0.0.1",
  "description": "Desktop launcher for lzt.market buyers — one-click login into purchased accounts.",
  "type": "module",
  "engines": {
    "node": ">=20.18"
  },
  "scripts": {
    "dev": "pnpm --filter @lolzteam/desktop dev",
    "build": "pnpm --filter @lolzteam/desktop build",
    "pack": "pnpm --filter @lolzteam/desktop pack",
    "dist": "pnpm --filter @lolzteam/desktop dist",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm --filter @lolzteam/desktop test",
    "lint": "biome check .",
    "format": "biome format --write .",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs,cjs,json,jsonc,css,scss}": [
      "biome check --write --no-errors-on-unmatched"
    ]
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "husky": "^9.1.7",
    "lint-staged": "^17.2.0",
    "typescript": "^5.7.2"
  },
  "packageManager": "pnpm@10.33.0"
}
